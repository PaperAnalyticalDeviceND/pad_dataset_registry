  "@id": "https://github.com/PaperAnalyticalDeviceND/pad_dataset_registry/tree/main/datasets/FHI360_Subset_PADFusion_v3.0",
  "@type": [
    "cr:Dataset",
    "schema:Dataset"
  ],
  "name": "FHI360_Subset_PADFusion_v3.0",
  "description": "CNN/NIR training corpus for the PaperAnalyticalDeviceND/model_fusion PAD + NIR multimodal fusion project. 503 PAD card images from 85 unique physical cards across four antibiotic APIs (amoxicillin, ciprofloxacin, doxycycline, isoniazid) at 20/50/80/100% plus a cellulose 0% control. v3.0 is a leak-free re-split of v2.0: grouped by sample_id and jointly stratified by (drug x concentration), 3 train / 1 val / 1 test cards per cell (no sample_id straddles splits).",
  "version": "v3.0",
  "datePublished": "2026-08-09T20:57:30Z",
  "license": "https://www.apache.org/licenses/LICENSE-2.0",
  "creator": {
